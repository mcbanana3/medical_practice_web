VITE_SITE_URL=

# Public reCAPTCHA v2 Checkbox site key. Never put the secret here.
VITE_RECAPTCHA_SITE_KEY=

# Leave empty when frontend and API share an origin or use the Vite proxy.
VITE_API_BASE_URL=
# Enable only on the public production deployment with its canonical HTTPS domain.
VITE_PUBLIC_INDEXING=false
